# segredos
.env

# cache do osmnx / dados de trânsito
cache/*
# o grafo de Messejana (~800 KB) vai no repositório: a hospedagem do back-end não precisa baixar do Overpass
!cache/grafo-*.graphml

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# claude code (local)
.claude/settings.local.json

# omc
.omc/

# front
front/node_modules/
front/dist/

# fontes 3D baixadas (MeshFleet/Sketchfab): só o .glb convertido vai para public/models
front/fontes-3d/

# vídeo comercial: só roteiro e scripts versionados
video/audio/
video/captura/
video/saida/
video/scratch/
video/node_modules/
video/*.log
